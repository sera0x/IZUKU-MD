# ─── core ────────────────────────────────────────────────────────────────
# Session id from the pairing site (IZUKU-XXXXXXXXXXXX). Leave empty to pair
# with a code at startup (set PAIRING_NUMBER), or to scan a QR.
SESSION_ID=
PAIRING_NUMBER=
# Digits only, with country code.
OWNER_NUMBER=
SUDO=

BOT_NAME=IZUKU-MD
OWNER_NAME=sera0x
PREFIX=.
# public = replies to everyone, private = owner only
WORKTYPE=public
VERSION=2.0.0

# ─── behaviour ───────────────────────────────────────────────────────────
AUTO_READ_STATUS=false
AUTO_STATUS_VIEW_DELAY=0
AUTO_STATUS_REACT=
AUTO_REACTION=false
ALWAYS_ONLINE=false
TYPING=false
ANTI_CALL=false
READ_MESSAGE=true
STARTUP_MESSAGE=true

# deleted message recovery: off | same | jid
ANTI_DELETE=off
ANTI_DELETE_JID=

# group guards
ANTILINK_VALUES=chat.whatsapp.com,wa.me,t.me
ANTILINK_ACTION=remove
ANTI_BAD_WORD=
FAKE_COUNTRY_CODE=
WARN_COUNT=3
COMMAND_COOLDOWN_MS=1500

# WELCOME_MESSAGE=👋 *Hi @user* — welcome to *@group* (#@count)
# GOODBYE_MESSAGE=👋 *@user* left *@group*.

# ─── branding ────────────────────────────────────────────────────────────
REPO_URL=https://github.com/sera0x/IZUKU-MD
INSTAGRAM=https://instagram.com/sera0x
CONTACT_EMAIL=
THUMB_IMAGE=
LOG_LEVEL=info
