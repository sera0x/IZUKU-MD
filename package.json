{
    "name": "izuku-md",
    "version": "0.0.7",
    "description": "WhatsApp bot built with Bun, TypeScript and Baileys.",
    "main": "index.js",
    "type": "module",
    "engines": {
        "node": ">=20.0.0",
        "bun": ">=1.1.0"
    },
    "scripts": {
        "start": "node index.js",
        "dev": "bun --watch src/index.ts",
        "build": "tsc",
        "check": "tsc --noEmit && bun src/scripts/check.ts",
        "test": "bun src/scripts/test.ts",
        "service": "bash scripts/service.sh",
        "secrets:push": "bash scripts/dkit-secrets.sh",
        "postinstall": "node scripts/patch-baileys.mjs && node_modules/typescript/bin/tsc"
    },
    "author": "sera0x",
    "license": "GPL-3.0",
    "dependencies": {
        "@adiwajshing/keyed-db": "^0.2.4",
